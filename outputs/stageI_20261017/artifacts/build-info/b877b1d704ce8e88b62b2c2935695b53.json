{"id":"b877b1d704ce8e88b62b2c2935695b53","_format":"hh-sol-build-info-1","solcVersion":"0.8.26","solcLongVersion":"0.8.26+commit.8a97fa7a.Emscripten.clang","input":{"language":"Solidity","sources":{"contracts/RecomputeProbe.sol":{"content":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.24;\n\n/// @notice Measurement-only contract: the same hash chain and ordered vector commitment as\n/// BoundedTaskRollup.compute, without the 128-step cap, so recomputation gas can be measured\n/// up to the block gas limit. It holds no funds and settles nothing.\ncontract RecomputeProbe {\n    bytes32 public last;\n\n    function recompute(bytes32 initial, uint32 steps) external returns (bytes32 output, bytes32 root) {\n        bytes32[] memory trace = new bytes32[](uint256(steps) + 1);\n        trace[0] = initial;\n        for (uint256 i = 0; i < steps; ++i) trace[i + 1] = keccak256(abi.encode(i, trace[i]));\n        output = trace[steps];\n        root = keccak256(abi.encode(trace));\n        last = output;\n    }\n}\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"viaIR":true,"evmVersion":"cancun","outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","evm.methodIdentifiers","metadata"],"":["ast"]}}}},"output":{"sources":{"contracts/RecomputeProbe.sol":{"ast":{"absolutePath":"contracts/RecomputeProbe.sol","exportedSymbols":{"RecomputeProbe":[85]},"id":86,"license":"MIT","nodeType":"SourceUnit","nodes":[{"id":1,"literals":["solidity","^","0.8",".24"],"nodeType":"PragmaDirective","src":"32:24:0"},{"abstract":false,"baseContracts":[],"canonicalName":"RecomputeProbe","contractDependencies":[],"contractKind":"contract","documentation":{"id":2,"nodeType":"StructuredDocumentation","src":"58:256:0","text":"@notice Measurement-only contract: the same hash chain and ordered vector commitment as\n BoundedTaskRollup.compute, without the 128-step cap, so recomputation gas can be measured\n up to the block gas limit. It holds no funds and settles nothing."},"