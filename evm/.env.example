# Sepolia deployment settings
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0xyour_private_key_without_spaces
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: if omitted, deployment scripts use the deployer address as the mock TEE signer.
TEE_SIGNER_ADDRESS=0xyour_tee_signer_address

# Optional deployment parameters
DISPUTE_WINDOW_SECONDS=60
CHALLENGE_TIMEOUT_SECONDS=2
MAX_BISECTION_ROUNDS=16
