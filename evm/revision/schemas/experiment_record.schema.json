{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hybrid-tee-rollup:sample:v1",
  "$comment": "结构约束由本 schema 执行；跨字段算术、真实日期、公开信息与跨行身份约束由 experiment_record.js 执行。仅用于阶段 A 本地实验，不接受真实网络费用或真实 TEE/DA 声明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "experimentId", "caseId", "sampleId", "status", "statusReason", "startedAtUtc", "endedAtUtc", "durationMs", "gitHead", "configSha256", "chain", "workload", "backend", "timeline", "cost", "throughput", "failure", "evidence", "notApplicableReason"],
  "properties": {
    "schemaVersion": {"const": "hybrid-tee-rollup.sample.v1"},
    "runId": {"$ref": "#/definitions/id"},
    "experimentId": {"$ref": "#/definitions/id"},
    "caseId": {"$ref": "#/definitions/id"},
    "sampleId": {"$ref": "#/definitions/id"},
    "status": {"enum": ["pass", "fail", "blocked", "skipped"]},
    "statusReason": {"anyOf": [{"$ref": "#/definitions/reason"}, {"type": "null"}]},
    "startedAtUtc": {"$ref": "#/definitions/utc"},
    "endedAtUtc": {"$ref": "#/definitions/utc"},
    "durationMs": {"type": "number", "minimum": 0},
    "gitHead": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "configSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "chain": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "chainId", "hardfork"],
      "properties": {
        "backend": {"const": "hardhat"}, "chainId": {"const": 31337}, "hardfork": {"const": "cancun"},
        "network": {"const": "hardhat-local"}, "rpcMode": {"const": "in-process"},
        "finalityDefinition": {"const": "local-automining-no-consensus-finality"}
      }
    },
    "backend": {
      "type": "object", "additionalProperties": false, "required": ["tee", "da", "blobMode"],
      "properties": {"tee": {"const": "simulated-only"}, "da": {"const": "local-mock-or-offline-only"}, "blobMode": {"const": "offline-only"}}
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["batchSize", "taskCount", "dispatchGroupSize", "payloadKiBPerTask", "payloadBytesPerTask", "batchPayloadBytes", "frameBytes", "encodedBytes", "blobCount", "blobBytes", "paddingBytes", "fieldPaddingBytes", "encoderMaxBlobs", "stepCount", "configuredConcurrency", "actualInFlight", "concurrencyUnit"],
      "properties": {
        "batchSize": {"$ref": "#/definitions/positiveInteger"}, "taskCount": {"$ref": "#/definitions/positiveInteger"},
        "dispatchGroupSize": {"$ref": "#/definitions/nullablePositiveInteger"},
        "payloadKiBPerTask": {"type": "number", "exclusiveMinimum": 0},
        "payloadBytesPerTask": {"$ref": "#/definitions/positiveInteger"}, "batchPayloadBytes": {"$ref": "#/definitions/positiveInteger"},
        "frameBytes": {"$ref": "#/definitions/nullableInteger"}, "encodedBytes": {"$ref": "#/definitions/nullableInteger"},
        "blobCount": {"$ref": "#/definitions/nullableInteger"}, "blobBytes": {"const": 131072},
        "paddingBytes": {"$ref": "#/definitions/nullableInteger"}, "fieldPaddingBytes": {"$ref": "#/definitions/nullableInteger"},
        "encoderMaxBlobs": {"const": 1}, "stepCount": {"$ref": "#/definitions/nullablePositiveInteger"},
        "configuredConcurrency": {"$ref": "#/definitions/positiveInteger"}, "actualInFlight": {"$ref": "#/definitions/nullablePositiveInteger"},
        "concurrencyUnit": {"const": "inflight_batches"}
      }
    },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["faultInjectedAt", "failureDetectedAt", "recoveryTriggeredAt", "firstValidProgressAt", "resolvedAt", "finalizedAt", "withdrawableAt"],
      "properties": {
        "faultInjectedAt": {"$ref": "#/definitions/nullableUtc"}, "failureDetectedAt": {"$ref": "#/definitions/nullableUtc"},
        "recoveryTriggeredAt": {"$ref": "#/definitions/nullableUtc"}, "firstValidProgressAt": {"$ref": "#/definitions/nullableUtc"},
        "resolvedAt": {"$ref": "#/definitions/nullableUtc"}, "finalizedAt": {"$ref": "#/definitions/nullableUtc"}, "withdrawableAt": {"$ref": "#/definitions/nullableUtc"}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["gasUsed", "l1ExecutionGas", "effectiveGasPrice", "l1ExecutionFee", "blobGasUsed", "blobGasPrice", "blobFee", "teeExecutionCost", "teeVerificationCost", "daServiceCost", "challengeCost", "recoveryCost", "settlementCost", "totalMeasuredCost", "costPerFinalizedTask", "costPerAcceptedTask", "costPerSubmittedBatch", "failedAttemptCost", "finalizedTasks", "acceptedTasks", "submittedBatches", "feeStatus", "feeSource"],
      "properties": {
        "gasUsed": {"$ref": "#/definitions/nullableInteger"}, "l1ExecutionGas": {"$ref": "#/definitions/nullableInteger"},
        "effectiveGasPrice": {"type": "null"}, "l1ExecutionFee": {"type": "null"}, "blobGasUsed": {"type": "null"}, "blobGasPrice": {"type": "null"}, "blobFee": {"type": "null"},
        "teeExecutionCost": {"type": "null"}, "teeVerificationCost": {"type": "null"}, "daServiceCost": {"type": "null"},
        "challengeCost": {"type": "null"}, "recoveryCost": {"type": "null"}, "settlementCost": {"type": "null"},
        "totalMeasuredCost": {"type": "null"}, "costPerFinalizedTask": {"type": "null"}, "costPerAcceptedTask": {"type": "null"}, "costPerSubmittedBatch": {"type": "null"}, "failedAttemptCost": {"type": "null"},
        "finalizedTasks": {"$ref": "#/definitions/nullableInteger"}, "acceptedTasks": {"$ref": "#/definitions/nullableInteger"}, "submittedBatches": {"$ref": "#/definitions/nullableInteger"},
        "feeStatus": {"const": "not_measured"}, "feeSource": {"const": "local-gas-only"}
      }
    },
    "throughput": {
      "type": "object", "additionalProperties": false, "required": ["executionThroughput", "acceptedThroughput", "finalizedThroughput"],
      "properties": {"executionThroughput": {"$ref": "#/definitions/throughput"}, "acceptedThroughput": {"$ref": "#/definitions/throughput"}, "finalizedThroughput": {"$ref": "#/definitions/throughput"}}
    },
    "failure": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/failure"}]},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/evidencePath"}},
    "notApplicableReason": {
      "type": "object",
      "propertyNames": {"pattern": "^(workload\\.(dispatchGroupSize|frameBytes|encodedBytes|blobCount|paddingBytes|fieldPaddingBytes|stepCount|actualInFlight)|timeline\\.(faultInjectedAt|failureDetectedAt|recoveryTriggeredAt|firstValidProgressAt|resolvedAt|finalizedAt|withdrawableAt)|cost\\.(gasUsed|l1ExecutionGas|effectiveGasPrice|l1ExecutionFee|blobGasUsed|blobGasPrice|blobFee|teeExecutionCost|teeVerificationCost|daServiceCost|challengeCost|recoveryCost|settlementCost|totalMeasuredCost|costPerFinalizedTask|costPerAcceptedTask|costPerSubmittedBatch|failedAttemptCost|finalizedTasks|acceptedTasks|submittedBatches)|throughput\\.(executionThroughput|acceptedThroughput|finalizedThroughput)\\.(value|numerator|denominator|start|end|failure|retry))$"},
      "additionalProperties": {"$ref": "#/definitions/reason"}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["fail", "blocked"]}}}, "then": {"properties": {"failure": {"$ref": "#/definitions/failure"}}}, "else": {"properties": {"failure": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "skipped"}}}, "then": {"properties": {"statusReason": {"$ref": "#/definitions/reason"}}}}
  ],
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "nullablePositiveInteger": {"anyOf": [{"$ref": "#/definitions/positiveInteger"}, {"type": "null"}]},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "nullableUtc": {"anyOf": [{"$ref": "#/definitions/utc"}, {"type": "null"}]},
    "evidencePath": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:%?#\\x00-\\x20])[A-Za-z0-9_\\-./\\u0080-\\uffff]+$"},
    "failure": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/definitions/id"}, "message": {"$ref": "#/definitions/reason"}}},
    "throughput": {
      "type": "object", "additionalProperties": false, "required": ["value", "numerator", "denominator", "start", "end", "failure", "retry"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0}, "numerator": {"$ref": "#/definitions/nullableInteger"},
        "denominator": {"type": ["number", "null"], "minimum": 0}, "start": {"$ref": "#/definitions/nullableUtc"}, "end": {"$ref": "#/definitions/nullableUtc"},
        "failure": {"$ref": "#/definitions/nullableInteger"}, "retry": {"$ref": "#/definitions/nullableInteger"}
      }
    }
  }
}
