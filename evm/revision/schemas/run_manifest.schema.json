{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hybrid-tee-rollup:run-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "createdAtUtc", "status", "gitHead", "gitBranch", "gitDirty", "trackedDiffSha256", "untrackedFiles", "sourceTreeSha256", "sourceFileSha256Path", "configPath", "configSha256", "environmentSnapshotPath", "dependencySnapshotPath", "chain", "build", "workload", "backends", "metricDefinitions", "evidenceRoot", "limitations"],
  "properties": {
    "schemaVersion": {"const": "hybrid-tee-rollup.stageA.v1"},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
    "createdAtUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "status": {"enum": ["planned", "ready", "closed", "fail", "blocked"]},
    "gitHead": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "gitBranch": {"type": "string", "minLength": 1},
    "gitDirty": {"type": "boolean"},
    "trackedDiffSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "untrackedFiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sourceTreeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceFileSha256Path": {"const": "manifest/source_files.sha256"},
    "configPath": {"const": "manifest/config.resolved.json"},
    "configSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environmentSnapshotPath": {"const": "manifest/environment_public.json"},
    "dependencySnapshotPath": {"const": "manifest/dependencies.json"},
    "chain": {"type": "object"}, "build": {"type": "object"}, "workload": {"type": "object"}, "backends": {"type": "object"},
    "metricDefinitions": {"type": "object"}, "evidenceRoot": {"const": "."},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
